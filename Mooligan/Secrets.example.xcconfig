// Copy to Secrets.xcconfig (gitignored) and fill in.
//
// Base URL of your deployed MTGGraphQL proxy (Tools/mtggraphql-proxy).
// Leave empty to disable the price history section entirely.
//
// Note the escaped slashes: xcconfig treats // as a comment.
MTGGRAPHQL_PROXY_URL = https:/$()/mtggraphql-proxy.your-subdomain.workers.dev
